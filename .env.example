# ==============================================================================
# StartupAI Manager — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate variables appropriate for your target mode.
# DO NOT commit the populated '.env' file into version control.

# ==============================================================================
# SECTION 1: CORE APPLICATION SETTINGS
# ==============================================================================
PROJECT_NAME="StartupAI Manager"
API_V1_PREFIX="/api/v1"

# Allowed CORS Origins (JSON list or comma-separated strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Rate Limiting (Requests per IP per minute)
RATE_LIMIT_PER_MINUTE=100

# ==============================================================================
# SECTION 2: AI PROVIDER & GUARDRAIL CONFIGURATION
# ==============================================================================
# AI Provider selection: "mock" (offline/zero cost), "gemini", "openai", "anthropic"
AI_PROVIDER_DEFAULT="mock"

# API Keys (Required only if corresponding provider is active; leave empty for 'mock')
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# AI Cost & Operational Safety Guardrails
MAX_TOKENS_PER_REQUEST=4000
MAX_AGENT_ITERATIONS=10
AI_REQUEST_TIMEOUT_SECONDS=30
WORKSPACE_MONTHLY_AI_BUDGET=100.0

# ==============================================================================
# SECTION 3: DEVELOPMENT ENVIRONMENT (Default for local development)
# ==============================================================================
# ENVIRONMENT="development"
# DEBUG=True
# DATABASE_URL="sqlite:///./startup_ai.db"
# SECRET_KEY="startupai-manager-dev-secret-key-change-in-production-2026-argon2"
# ALGORITHM="HS256"
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# REDIS_URL=""

# ==============================================================================
# SECTION 4: TEST ENVIRONMENT (Used during automated pytest execution)
# ==============================================================================
# ENVIRONMENT="test"
# DEBUG=False
# DATABASE_URL="sqlite:///:memory:"
# SECRET_KEY="test-environment-mock-secret-key-at-least-32-chars-long"
# ALGORITHM="HS256"
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=1
# AI_PROVIDER_DEFAULT="mock"

# ==============================================================================
# SECTION 5: PRODUCTION ENVIRONMENT (Required for live deployment)
# ==============================================================================
# In production, ENVIRONMENT must be "production" and DEBUG must be False.
# SECRET_KEY must be a cryptographically secure random string with >= 32 characters.
# Generate via: openssl rand -hex 32
#
# ENVIRONMENT="production"
# DEBUG=False
# DATABASE_URL="postgresql+psycopg2://postgres_user:STRONG_SECURE_PASSWORD@postgres:5432/startupai_prod"
# SECRET_KEY="GENERATE_A_64_CHAR_HEX_KEY_DO_NOT_USE_DEFAULT"
# ALGORITHM="HS256"
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# REDIS_URL="redis://:STRONG_REDIS_PASSWORD@redis:6379/0"
# BACKEND_CORS_ORIGINS=["https://startupai.example.com"]
